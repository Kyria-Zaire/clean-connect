{
  "name": "@cc/admin",
  "version": "0.1.0",
  "private": true,
  "description": "Clean Connect — dashboard admin (Vite + React + shadcn/ui).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
