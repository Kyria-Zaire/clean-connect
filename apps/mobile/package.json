{
  "name": "@cc/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Clean Connect — application mobile unique (Client + Prestataire) — Expo managed.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "build": "echo 'build: handled by EAS Build (cf. ADR-001 phase prod)'",
    "clean": "rimraf .expo dist node_modules/.cache"
  },
  "dependencies": {
    "@cc/design-tokens": "workspace:*",
