// =============================================================================
// Clean Connect — Schéma Prisma
// -----------------------------------------------------------------------------
// Sprint 0.2 : "Big Four" — User, Mission, Address, Photo
// PRD-003 Design (2026-05-12) : Payment / Transfer séparés, StripeWebhookEvent,
// WebhookDeadLetter, PhotoUploadSession, PhotoDeletionLog, AutoReleaseJob,
// extension Photo (variants ORIGINAL|DISPLAY, GPS, session), flags Stripe User.
//
// Conventions (rules `architecte-api` + `backend`) :
//   - Tous les montants sont en centimes (Int) — cf. ADR-002
//   - PostGIS via Unsupported("geography(Point, 4326)") — cf. ADR-003
//   - snake_case en DB, camelCase en TS (via @map / @@map)
//   - Tout select métier doit utiliser take: ou limit() (rule backend)
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// Génération automatique des schémas Zod depuis Prisma (à câbler après pnpm install).
// Référence : ADR-002, rule backend.
// Sortie : @cc/shared-types/zod/generated (à reconfigurer si on déplace le package).
generator zod {
  provider                         = "zod-prisma-types"
  output                           = "../../../packages/shared-types/src/zod/generated"
  createInputTypes                 = false
  createModelTypes                 = true
  addInputTypeValidation           = false
  useMultipleFiles                 = true
  writeBarrelFiles                 = true
  createOptionalDefaultValuesTypes = false
  prismaClientPath                 = "@prisma/client"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis(version: "3.4.0"), pg_trgm]
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum Role {
  CLIENT
  PRESTATAIRE
  ADMIN
}

/// Statuts mission — alignés avec `MissionStatusSchema` (`@cc/shared-types`).
/// Seules les transitions listées dans `mission-state.machine.ts` sont autorisées en MVP PRD-002 + PRD-003.
enum MissionStatus {
  DRAFT
  /// PRD-003 Ticket 3.2 — état intermédiaire entre `DRAFT` et `PUBLISHED` :
  /// `POST /v1/payments/intent` a créé un PaymentIntent (capture_method=manual),
  /// la mission attend l'autorisation Stripe (webhook
  /// `payment_intent.amount_capturable_updated`) avant de devenir visible.
  PENDING_PAYMENT
  PUBLISHED
  PROPOSED
  ACCEPTED
  EXPIRED
  CANCELLED
  // États réservés PRD aval (PRD-003 Ticket 3.4 active CLIENT_VALIDATION_PENDING,
  // COMPLETED, DISPUTE_OPEN ; `IN_PROGRESS` reste réservé à un futur /start endpoint
  // distinct, `REFUNDED` est livré en Ticket 3.5).
  IN_PROGRESS
  /// PRD-003 Ticket 3.4 — la mission est terminée côté prestataire (≥ 3 BEFORE
  /// + ≥ 5 AFTER photos syncées) et attend soit la validation manuelle CLIENT
  /// (`POST /missions/:id/validate`), soit l'auto-release T+48h ouvrées
  /// (BullMQ delayed job), soit l'ouverture d'un litige
  /// (`POST /missions/:id/report-problem` → `DISPUTE_OPEN`).
  CLIENT_VALIDATION_PENDING
  /// PRD-003 Ticket 3.4 — état terminal succès : `Payment` est `CAPTURED`
  /// (webhook `payment_intent.succeeded` confirmé). Transfer prestataire =
  /// Ticket 3.5.
  COMPLETED
  /// PRD-003 Ticket 3.4 — `POST /missions/:id/report-problem` (CLIENT) ou
  /// `charge.dispute.created` (Ticket 3.5). Bloque tout auto-release / capture
  /// future tant que le litige n'est pas instruit (process complet = PRD-005).
  DISPUTE_OPEN
  REFUNDED
}

/// Types de prestation — alignés avec `MissionServiceTypeSchema` (`@cc/shared-types`).
enum MissionServiceType {
  SOFA
  MATTRESS
  TERRACE
  TRASH_BINS
  CARPET
  OTHER
}

enum PhotoType {
  BEFORE
  AFTER
}

/// Variante Cloudinary — **DISPLAY** = EXIF strip + optimisé ; **ORIGINAL** = conservé sécurisé (audit / litige). ADR-009.
enum PhotoVariant {
  ORIGINAL
  DISPLAY
}

/// Cycle de vie paiement carte (PaymentIntent). **Ne pas** mélanger avec le transfert Connect — cf. décision CTO Design PRD-003.
/// Ajustements revue CTO 2026-05-12 (rev2 state machines) :
/// - `AUTHORIZATION_PENDING` (PRD-003 Ticket 3.2) = PaymentIntent créé (capture_method=manual),
///   en attente du webhook `payment_intent.amount_capturable_updated`. État INITIAL strict.
/// - `CANCELLED` = capture abandonnée (`payment_intent.canceled`) ou autorisation Visa/MC expirée ~7j (`authorization_expired`).
/// - `REFUND_PENDING` = refund émis admin, attente `charge.refunded` (lifecycle dédié `RefundStatus` + table `Refund`).
enum PaymentStatus {
  AUTHORIZATION_PENDING
  AUTHORIZED
  CAPTURED
  REFUND_PENDING
  REFUNDED
  FAILED
  CANCELLED
}

/// Transfert vers compte Connect Express — état distinct du paiement.
/// `REVERSED` = alimenté par webhook Stripe `transfer.reversed` (reversal / fonds repris /
/// correction post-transfer, p. ex. compte prestataire fermé ou fraude détectée).
/// Effet métier (cf. ADR-008) : mission bascule en `DISPUTE_OPEN`, re-transfert manuel hors MVP.
/// Ajustement revue CTO 2026-05-12 (rev2) : `RETRY_SCHEDULED` permet `FAILED → RETRY_SCHEDULED → PENDING`
/// (retry idempotent même `idempotencyKey`, piloté DLQ admin ou BullMQ exponentiel ≤ 5 tentatives).
enum TransferStatus {
  PENDING
  SENT
  FAILED
  RETRY_SCHEDULED
  REVERSED
}

/// Cycle refund dédié (table `Refund`). Refund logique = 1 ligne `Refund` + N webhooks Stripe.
/// MVP : pas de refund partiel — `amountCents == Payment.amountCapturedCents` strict.
enum RefundStatus {
  PENDING
  REFUNDED
  FAILED
}

/// Verrouillage traitement webhook Stripe (`SELECT … FOR UPDATE` côté service — ADR-008 / ADR-011).
enum StripeWebhookProcessingStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

/// Synthèse onboarding / capabilities Stripe Connect — filtre matching strict (PRD-003 Discover Q7).
enum ProviderPayoutStatus {
  NOT_ONBOARDED
  ONBOARDING_IN_PROGRESS
  IDENTITY_PENDING
  PAYOUTS_DISABLED
  CHARGES_DISABLED
  READY
}

/// États terminaux : `COMPLETED`, `FAILED`, `CANCELLED` (revue CTO 2026-05-12 — renommage `SUCCEEDED → COMPLETED`
/// pour homogénéité naming des terminaux côté state machines).
enum AutoReleaseJobStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
  FAILED
}

enum WebhookDeadLetterSource {
  STRIPE
  CLOUDINARY
}

enum PhotoDeletionReason {
  RETENTION_POLICY
  LEGAL_HOLD
  FRAUD_INVESTIGATION
  ADMIN_ACTION
}

enum PhotoDeletionActor {
  SYSTEM
  ADMIN
}

// -----------------------------------------------------------------------------
// PRD-004 Ticket 4.5 — Monitoring financier
// -----------------------------------------------------------------------------

/// Type de run finance — un par scheduler (cf. PRD-004 §4.15.11).
enum FinanceRunType {
  RECONCILE
  STUCK
  INVARIANTS
  REPORT
  PAYOUT_ANOMALY
}

/// Cycle de vie d'un run scheduler finance. Pas de `PENDING` — un run est créé
/// directement en `RUNNING` après acquisition du lock anti-overlap.
enum FinanceRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// Types de mismatch détectés par les schedulers — labels Prometheus alignés
/// (`cleanconnect_finance_mismatches_total{type}`).
enum FinanceMismatchType {
  STATUS
  AMOUNT
  CURRENCY
  MISSING_DB
  MISSING_STRIPE
  INVARIANT_SUM
  STUCK_PENDING
  STUCK_AUTHORIZATION
  STUCK_CAPTURED
  PAYOUT_ANOMALY
}

/// Ressource finance ciblée par le mismatch.
enum FinanceResourceKind {
  PAYMENT
  TRANSFER
  REFUND
  INVARIANT
}

/// Workflow admin d'un mismatch (PRD §4.15.4 + runbook).
/// Build itération 2 (Ticket 4.5 §4.15.16) : ajout `ACKNOWLEDGED` — l'admin
/// reconnaît le mismatch sans encore le résoudre (étape intermédiaire OPEN→ACK→RESOLVED).
/// Transitions strictes (cf. `FinanceMismatchService.transition`) :
///   OPEN → ACKNOWLEDGED | INVESTIGATING | RESOLVED | IGNORED
///   ACKNOWLEDGED → INVESTIGATING | RESOLVED | IGNORED
///   INVESTIGATING → RESOLVED | IGNORED
///   RESOLVED / IGNORED ⇒ terminaux (pas de retour OPEN sans nouveau mismatch).
enum FinanceMismatchStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  IGNORED
}

// -----------------------------------------------------------------------------
// User
// -----------------------------------------------------------------------------

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique @db.VarChar(320)
  passwordHash String @map("password_hash")
  firstName    String @map("first_name") @db.VarChar(80)
  lastName     String @map("last_name") @db.VarChar(80)
  role         Role

  // Stripe — `stripeCustomerId` pour CLIENT, `stripeAccountId` (Connect Express) pour PRESTATAIRE
  stripeCustomerId       String?              @unique @map("stripe_customer_id")
  stripeAccountId        String?              @unique @map("stripe_account_id")
  /// Capabilities Stripe (webhook `account.updated`) — source de vérité partielle pour `providerPayoutStatus`.
  stripeChargesEnabled   Boolean?             @map("stripe_charges_enabled")
  stripeTransfersEnabled Boolean?             @map("stripe_transfers_enabled")
  stripePayoutsEnabled   Boolean?             @map("stripe_payouts_enabled")
  /// Exigences KYC Stripe (`requirements.currently_due`, etc.).
  stripeRequirementsDue  Json?                @map("stripe_requirements_due")
  /// Synthèse onboarding — filtre matching strict (PRD-003).
  providerPayoutStatus   ProviderPayoutStatus @default(NOT_ONBOARDED) @map("provider_payout_status")

  // Adresse de l'utilisateur (résidence client OU base prestataire pour matching)
  addressId String?  @unique @map("address_id") @db.Uuid
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  // Soft delete RGPD — 30j puis purge (sauf obligations légales paiement = 10 ans, cf. cahier v1.4 §3.3)
  deletedAt DateTime? @map("deleted_at")

  /// Vérification compte (KYC, email, etc.). MVP PRD-002 : auto-set à la création
  /// (CURRENT_TIMESTAMP) — workflow de vérification réel ouvert à un PRD ultérieur.
  /// `null` ⇒ exclusion immédiate du matching (contrainte CTO Build §5).
  verifiedAt DateTime? @default(now()) @map("verified_at")

  /// Suspension administrative (admin, anti-fraude). `null` = compte actif.
  /// `<> null` ⇒ exclusion immédiate du matching + login refusé (PRD futur).
  suspendedAt DateTime? @map("suspended_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  /// Rayon d'intervention prestataire (km) — défaut 15, plafond 30 (PRD-002 Discover CTO).
  serviceRadiusKm Int @default(15) @map("service_radius_km")

  // Relations missions
  missionsAsClient      Mission[]            @relation("MissionClient")
  missionsAsPrestataire Mission[]            @relation("MissionPrestataire")
  missionProposals      MissionProposal[]
  missionEvents         MissionEvent[]
  photoUploadSessions   PhotoUploadSession[] @relation("PhotoUploadSessionUploader")
  photosUploaded        Photo[]              @relation("PhotoUploadedBy")

  @@index([role])
  @@index([deletedAt])
  @@index([suspendedAt])
  @@index([verifiedAt])
  @@index([providerPayoutStatus])
  @@map("users")
}

// -----------------------------------------------------------------------------
// RefreshToken (PRD-001) — opaque refresh, hash sha256 en DB, jamais en clair
// -----------------------------------------------------------------------------

model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// sha256 hex (64 chars) du refresh token opaque — lookup et unicité logique
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// -----------------------------------------------------------------------------
// Address
// -----------------------------------------------------------------------------
// La colonne `location` n'est pas représentable nativement en Prisma → Unsupported.
// Insertion / lecture via $queryRaw uniquement (cf. ADR-003 + rule backend).

model Address {
  id      String @id @default(uuid()) @db.Uuid
  street  String @db.VarChar(255)
  city    String @db.VarChar(120)
  zipCode String @map("zip_code") @db.VarChar(10)
  country String @default("FR") @db.Char(2)

  /// geography(Point, 4326) — coordonnées GPS WGS-84 (PostGIS) — cf. ADR-003
  location Unsupported("geography(Point, 4326)")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User?
  missions Mission[]

  @@index([city])
  @@index([zipCode])
  // L'index GIST sur location est créé manuellement dans la migration init.
  @@map("addresses")
}

// -----------------------------------------------------------------------------
// Mission
// -----------------------------------------------------------------------------

model Mission {
  id            String @id @default(uuid()) @db.Uuid
  /// Numéro lisible support / facturation (ex. `CC-2026-000123`) — unique métier.
  missionNumber String @unique @map("mission_number") @db.VarChar(32)

  status      MissionStatus      @default(DRAFT)
  serviceType MissionServiceType @map("service_type")

  // Acteurs
  clientId String @map("client_id") @db.Uuid
  client   User   @relation("MissionClient", fields: [clientId], references: [id], onDelete: Restrict)

  prestataireId String? @map("prestataire_id") @db.Uuid
  prestataire   User?   @relation("MissionPrestataire", fields: [prestataireId], references: [id], onDelete: Restrict)

  // Lieu de la mission (coords PostGIS sur `addresses.location` — cf. ADR-003)
  addressId String  @map("address_id") @db.Uuid
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  /// Fenêtre d'intervention (UTC en DB). Si `isAsap`, valeurs recalculées côté serveur à la publication.
  startAt  DateTime @map("start_at")
  endAt    DateTime @map("end_at")
  timeZone String   @map("time_zone") @db.VarChar(64)
  isAsap   Boolean  @default(false) @map("is_asap")

  /// Estimation prix client — hors périmètre tarifaire PRD-002 (cf. ADR-007). Nullable.
  estimatedPriceCents Int? @map("estimated_price_cents")

  publishedAt      DateTime? @map("published_at")
  /// Après publication : expiration liste marketplace si aucun accept (15 min MVP, configurable Build).
  listingExpiresAt DateTime? @map("listing_expires_at")

  /// PRD-003 : paiement carte (PaymentIntent) — 1:1 mission, `stripe_payment_intent_id` vit ici (plus sur `missions`).
  payment             Payment?
  photoUploadSessions PhotoUploadSession[]
  autoReleaseJobs     AutoReleaseJob[]
  photoDeletionLogs   PhotoDeletionLog[]

  proposals MissionProposal[]
  events    MissionEvent[]
  photos    Photo[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([clientId])
  @@index([prestataireId])
  @@index([startAt])
  @@index([listingExpiresAt])
  @@map("missions")
}

/// Audit minimal du cycle de vie mission (PRD-002 Build, contrainte CTO §1).
/// Une ligne par évènement métier (CREATED, PUBLISHED, MATCHING_DONE, ACCEPTED,
/// CANCELLED, EXPIRED, …). Schéma volontairement minimal — détail dans `payload`.
model MissionEvent {
  id        String  @id @default(uuid()) @db.Uuid
  missionId String  @map("mission_id") @db.Uuid
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  /// Type d'évènement métier — string libre côté Prisma (validé Zod côté service).
  type String @db.VarChar(64)

  /// Acteur ayant déclenché l'évènement (null pour les jobs système).
  actorUserId String? @map("actor_user_id") @db.Uuid
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// Payload technique additionnel — **sans PII / adresse complète**.
  payload Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([missionId, createdAt])
  @@index([type])
  @@map("mission_events")
}

/// Prestataires matchés pour une mission en statut `PROPOSED` (marketplace first-accept-wins — ADR-005).
model MissionProposal {
  id            String  @id @default(uuid()) @db.Uuid
  missionId     String  @map("mission_id") @db.Uuid
  mission       Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  prestataireId String  @map("prestataire_id") @db.Uuid
  prestataire   User    @relation(fields: [prestataireId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([missionId, prestataireId])
  @@index([missionId])
  @@index([prestataireId])
  @@map("mission_proposals")
}

// -----------------------------------------------------------------------------
// PRD-003 — Paiements & webhooks
// -----------------------------------------------------------------------------

model Payment {
  id        String  @id @default(uuid()) @db.Uuid
  missionId String  @unique @map("mission_id") @db.Uuid
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Restrict)

  stripePaymentIntentId String @unique @map("stripe_payment_intent_id") @db.VarChar(255)

  /// Clé idempotence client (header `Idempotency-Key`) — PRD-003 Ticket 3.2.
  /// Utilisée :
  ///   1. Pour deduplicate les replays HTTP (même clé + même missionId → même Payment).
  ///   2. Comme `idempotencyKey` Stripe à la création du PaymentIntent (rule stripe).
  /// Rétention min 24 h côté serveur (idempotency cache).
  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(255)

  /// Code d'erreur Stripe en cas de FAILED/CANCELLED (ex. `authorization_expired`,
  /// `card_declined`, `expired_card`). Renseigné côté handler webhook
  /// `payment_intent.payment_failed` / `payment_intent.canceled`.
  failureCode    String? @map("failure_code") @db.VarChar(120)
  /// Détail Stripe (`last_payment_error.message` ou `cancellation_reason`) —
  /// peut contenir un message brut Stripe, **JAMAIS PII carte** (rule securite +
  /// Pino redactor). Admin only sur surface API.
  failureMessage String? @map("failure_message") @db.Text

  // ---------------------------------------------------------------------------
  // Snapshots IMMUTABLES posés à la création du PaymentIntent.
  // Aucune mutation hors webhook Stripe correspondant (autorisation / capture).
  // Toute évolution tarifaire / commission doit créer un nouveau Payment.
  // ---------------------------------------------------------------------------

  /// Montant autorisé (centimes) — `amount` capturable côté Stripe après webhook autorisation. Snapshot immutable.
  amountAuthorizedCents Int    @map("amount_authorized_cents")
  /// Montant effectivement capturé (centimes), renseigné après `capture` (webhook `payment_intent.amount_capturable_updated` → succès capture).
  amountCapturedCents   Int?   @map("amount_captured_cents")
  /// Devise ISO-4217 (lowercase, alignement Stripe). EUR uniquement MVP (décision CTO Q11). Snapshot immutable.
  currency              String @default("eur") @db.VarChar(3)

  /// Commission plateforme snapshotée au moment du paiement (centimes).
  /// Cette commission sera appliquée lors du Transfer différé vers le prestataire.
  /// Elle ne change pas après la création du Payment.
  applicationFeeCents Int? @map("application_fee_cents")

  /// Montant net prestataire snapshoté (centimes) = `amountAuthorizedCents - applicationFeeCents` (lock-in au paiement).
  /// Utilisé tel quel à la création du Transfer Connect — aucun recalcul runtime, évite tout drift commission.
  providerPayoutCents Int? @map("provider_payout_cents")

  /// Snapshot TVA future (hors moteur TVA MVP — décision CTO Q14). Pas de logique TVA active en MVP.
  vatRateSnapshot Decimal?      @map("vat_rate_snapshot") @db.Decimal(5, 4)
  status          PaymentStatus

  transfer Transfer?
  refunds  Refund[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("payments")
}

/// Remboursement carte client (Stripe `Refund`). Cycle propre `RefundStatus`. MVP : **pas de refund partiel**
/// (cf. revue CTO 2026-05-12 — state machines rev2). `amountCents` = `Payment.amountCapturedCents` strict.
model Refund {
  id String @id @default(uuid()) @db.Uuid

  paymentId String  @map("payment_id") @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  /// Identifiant Stripe `re_*` — renseigné dès création (idempotent via `idempotencyKey`).
  stripeRefundId String? @unique @map("stripe_refund_id") @db.VarChar(255)

  /// Clé idempotence Stripe — déterministe `refund-mission-{missionId}-{attempt}`. Rétention min 24 h.
  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(255)

  /// MVP : refund intégral uniquement (`= Payment.amountCapturedCents`). Validation côté service.
  amountCents Int          @map("amount_cents")
  currency    String       @default("eur") @db.VarChar(3)
  status      RefundStatus
  reason      String?      @db.VarChar(255)

  /// Code Stripe en cas d'échec (`charge_for_pending_refund_disputed`, `expired_or_canceled_card`, …).
  failureCode   String? @map("failure_code") @db.VarChar(120)
  failureReason String? @map("failure_reason") @db.Text

  /// Audit acteur initiateur (admin id ou `SYSTEM` pour cancellation/expiration auto).
  initiatedBy String? @map("initiated_by") @db.VarChar(64)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  settledAt DateTime? @map("settled_at")

  @@index([paymentId, status])
  @@index([status])
  @@map("refunds")
}

model Transfer {
  id        String  @id @default(uuid()) @db.Uuid
  paymentId String  @unique @map("payment_id") @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  stripeTransferId String?        @unique @map("stripe_transfer_id") @db.VarChar(255)
  amountCents      Int            @map("amount_cents")
  currency         String         @default("eur") @db.VarChar(3)
  status           TransferStatus

  /// Clé idempotence Stripe — **déterministe** côté service (ex. `transfer-mission-{missionId}`).
  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(255)

  /// Compteur de tentatives — incrémenté à chaque retry (max 5 avant DLQ, cf. règle `stripe`).
  retryCount    Int       @default(0) @map("retry_count")
  /// Horodatage de la dernière tentative — null tant qu'aucun retry n'a été déclenché.
  lastRetryAt   DateTime? @map("last_retry_at")
  /// Code d'erreur Stripe (`balance_insufficient`, `account_closed`, etc.) — `null` si succès ou erreur réseau interne.
  failureCode   String?   @map("failure_code") @db.VarChar(120)
  /// Raison détaillée (message Stripe ou erreur interne) — utilisé pour audit + alerte ops.
  failureReason String?   @map("failure_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("transfers")
}

/// Événement Stripe entrant — anti-replay via `stripe_event_id` UNIQUE (PK) + `payload_hash` (ADR-008 / ADR-011).
/// `stripe_event_id` est PK ⇒ contrainte d'unicité implicite (idempotence stricte).
model StripeWebhookEvent {
  stripeEventId       String                        @id @map("stripe_event_id") @db.VarChar(255)
  type                String                        @db.VarChar(120)
  payloadHash         String                        @map("payload_hash") @db.VarChar(64)
  livemode            Boolean
  processingStatus    StripeWebhookProcessingStatus @default(PENDING) @map("processing_status")
  /// Horodatage d'arrivée du webhook (= `created_at` au sens projet — convention `createdAt`).
  createdAt           DateTime                      @default(now()) @map("created_at")
  /// Horodatage pris lors du verrou transactionnel (`SELECT … FOR UPDATE`) — évite double traitement concurrent.
  processingStartedAt DateTime?                     @map("processing_started_at")
  processedAt         DateTime?                     @map("processed_at")
  lastError           String?                       @map("last_error") @db.Text

  @@index([processingStatus, createdAt])
  @@map("stripe_webhook_events")
}

model WebhookDeadLetter {
  id              String                  @id @default(uuid()) @db.Uuid
  source          WebhookDeadLetterSource
  externalEventId String                  @map("external_event_id") @db.VarChar(255)
  payloadHash     String?                 @map("payload_hash") @db.VarChar(64)
  errorMessage    String                  @map("error_message") @db.Text
  attempts        Int                     @default(0)
  lastAttemptAt   DateTime                @map("last_attempt_at")
  resolvedAt      DateTime?               @map("resolved_at")
  createdAt       DateTime                @default(now()) @map("created_at")

  @@index([source, externalEventId])
  @@map("webhook_dead_letters")
}

/// Job auto-release T+48h ouvrées — traçabilité BullMQ / retries / audit (décision CTO Design).
model AutoReleaseJob {
  id        String  @id @default(uuid()) @db.Uuid
  missionId String  @map("mission_id") @db.Uuid
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  scheduledFor   DateTime             @map("scheduled_for")
  status         AutoReleaseJobStatus
  bullJobId      String?              @unique @map("bull_job_id") @db.VarChar(128)
  idempotencyKey String?              @unique @map("idempotency_key") @db.VarChar(255)
  cancelReason   String?              @map("cancel_reason") @db.VarChar(255)
  lastError      String?              @map("last_error") @db.Text

  /// Verrou applicatif : pris par le worker via `UPDATE … WHERE locked_at IS NULL` (anti double exécution simultanée
  /// même en cas de race BullMQ ↔ cron safety-net horaire — audit Verify V10).
  lockedAt DateTime? @map("locked_at")
  /// Identifiant du worker / pod qui détient le verrou (hostname, container id, ou worker uuid) — debugging + observabilité.
  lockedBy String?   @map("locked_by") @db.VarChar(255)

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([missionId, status])
  @@index([scheduledFor, status])
  @@index([lockedAt])
  @@map("auto_release_jobs")
}

// -----------------------------------------------------------------------------
// PRD-003 — Sessions upload photo (signed URL) + extension Photo
// -----------------------------------------------------------------------------

/// Session jeton court — anti cross-mission / prépare antivirus & modération (décision CTO Design).
model PhotoUploadSession {
  id             String  @id @default(uuid()) @db.Uuid
  missionId      String  @map("mission_id") @db.Uuid
  mission        Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  uploaderUserId String  @map("uploader_user_id") @db.Uuid
  uploader       User    @relation("PhotoUploadSessionUploader", fields: [uploaderUserId], references: [id], onDelete: Restrict)

  phase PhotoType @map("phase")

  /// Variant ciblé : ORIGINAL ou DISPLAY (ADR-009 dual variant). Le mobile fait
  /// 2 presigns + 2 uploads + 2 confirms (un par variant), avec le **même**
  /// `captureClientUuid` pour relier ORIGINAL/DISPLAY côté backend.
  variant PhotoVariant @default(ORIGINAL) @map("variant")

  /// UUID v4 client — borne anti cross-session (`confirm` vérifie l'égalité).
  captureClientUuid String @map("capture_client_uuid") @db.Uuid

  /// SHA-256 hex du jeton opaque — le secret n'est **jamais** stocké en clair.
  tokenDigest String    @unique @map("token_digest") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")

  /// Taille max fichier (octets) — défaut 10 MiB (ADR-009).
  maxBytes Int @default(10485760) @map("max_bytes")

  /// MIME annoncé par le mobile (whitelist Zod). Sert au confirm pour
  /// re-vérifier la cohérence sans re-poser un index lourd.
  mimeType String @map("mime_type") @db.VarChar(32)

  /// Cloudinary public_id pré-calculé serveur — `${env}/missions/{missionId}/{phase}/{captureClientUuid}/{variant}`.
  /// Le mobile NE peut PAS forger un autre public_id (signature Cloudinary scellée).
  cloudinaryPublicId String @map("cloudinary_public_id") @db.VarChar(1024)

  createdAt DateTime @default(now()) @map("created_at")

  photos Photo[]

  @@index([missionId, phase])
  @@index([expiresAt])
  @@map("photo_upload_sessions")
}

// -----------------------------------------------------------------------------
// Photo
// -----------------------------------------------------------------------------

model Photo {
  // L'ID est généré CÔTÉ CLIENT (UUID v4) pour assurer l'idempotence des uploads offline.
  // Référence : cahier v1.4 §6 (mode offline) + rule mobile.
  id        String  @id @db.Uuid
  missionId String  @map("mission_id") @db.Uuid
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  /// PRD-003 Ticket 3.3 — uploader réel, pour audit RGPD (droit à l'effacement
  /// scoped utilisateur) et RBAC lecture (le prestataire ne lit que ses
  /// uploads). Renseigné côté `confirm` à partir de `photoUploadSession.uploaderUserId`.
  uploadedByUserId String @map("uploaded_by_user_id") @db.Uuid
  uploadedBy       User   @relation("PhotoUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  type PhotoType

  /// URL legacy / display rapide — les nouveaux flux privilégient `cloudinaryPublicId` + signed URL.
  url      String @db.VarChar(2048)
  metadata Json   @default("{}")

  /// Variante Cloudinary — DISPLAY = strip EXIF + optimisé ; ORIGINAL = conservé sécurisé (ADR-009).
  variant PhotoVariant @default(DISPLAY) @map("variant")

  /// UUID v4 logique de la capture mobile — **OBLIGATOIRE** pour ORIGINAL et DISPLAY.
  /// Relie la paire ORIGINAL/DISPLAY (même valeur pour les deux variants d'une même capture).
  /// Garantit l'idempotence d'upload côté serveur : PostgreSQL n'accepterait pas plusieurs NULL
  /// malgré la contrainte `@@unique([missionId, captureClientUuid, variant])` (NULLs distincts par défaut).
  captureClientUuid String @map("capture_client_uuid") @db.Uuid

  photoUploadSessionId String?             @map("photo_upload_session_id") @db.Uuid
  photoUploadSession   PhotoUploadSession? @relation(fields: [photoUploadSessionId], references: [id], onDelete: SetNull)

  cloudinaryPublicId String? @map("cloudinary_public_id") @db.VarChar(1024)
  checksumSha256     String? @map("checksum_sha256") @db.VarChar(64)

  gpsLatitude       Decimal? @map("gps_latitude") @db.Decimal(10, 8)
  gpsLongitude      Decimal? @map("gps_longitude") @db.Decimal(11, 8)
  gpsAccuracyMeters Int?     @map("gps_accuracy_meters")
  gpsMissing        Boolean  @default(false) @map("gps_missing")
  flagSuspicious    Boolean  @default(false) @map("flag_suspicious")

  syncedAt    DateTime? @map("synced_at")
  imageWidth  Int?      @map("image_width")
  imageHeight Int?      @map("image_height")
  bytes       Int?

  /// Tombstone après purge asset Cloudinary — la ligne reste pour audit (ADR-010).
  deletedAt DateTime? @map("deleted_at")

  // Rétention RGPD : purge automatique — **30 jours** post fin mission (PRD-003 ADR-010, remplace 12 mois rule legacy).
  createdAt DateTime @default(now()) @map("created_at")

  photoDeletionLogs PhotoDeletionLog[]

  @@unique([missionId, captureClientUuid, variant])
  @@unique([cloudinaryPublicId])
  @@index([missionId, type])
  @@index([photoUploadSessionId])
  @@index([uploadedByUserId])
  @@map("photos")
}

/// Audit des suppressions (cron rétention, litige, fraude) — **aucune** suppression manuelle client/prestataire (décision CTO Design).
model PhotoDeletionLog {
  id      String @id @default(uuid()) @db.Uuid
  photoId String @map("photo_id") @db.Uuid
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Restrict)

  missionId String  @map("mission_id") @db.Uuid
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  reason      PhotoDeletionReason
  performedBy PhotoDeletionActor  @map("performed_by")
  batchId     String?             @map("batch_id") @db.VarChar(64)
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([missionId, createdAt])
  @@index([batchId])
  @@map("photo_deletion_logs")
}

// -----------------------------------------------------------------------------
// PRD-004 Ticket 4.5 — Finance tables
// -----------------------------------------------------------------------------

/// Exécution d'un scheduler finance (1 row par run). PRD-004 §4.15.4.
/// Rétention : 90 j si `COMPLETED` (cron `FinanceRetentionScheduler`).
/// Les runs `FAILED` sont conservés au-delà jusqu'à résolution manuelle (cf.
/// PRD-004 §4.15.4 — décision Build CTO OQ-12).
model FinanceReconciliationRun {
  id     String           @id @default(uuid()) @db.Uuid
  type   FinanceRunType
  status FinanceRunStatus

  /// Fenêtre d'analyse — bornes UTC. Pour `REPORT`, `windowFrom` = J-1 00:00 Europe/Paris (UTC).
  windowFrom DateTime @map("window_from")
  windowTo   DateTime @map("window_to")

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  /// Durée en ms — calculée à la fin du run (alimente l'histogram `cleanconnect_finance_reconciliation_duration_seconds`).
  durationMs  Int?      @map("duration_ms")

  /// Compteurs agrégés du run — pas de PII (toutes valeurs numériques).
  resourcesScanned Int @default(0) @map("resources_scanned")
  mismatchesFound  Int @default(0) @map("mismatches_found")
  alertsEmitted    Int @default(0) @map("alerts_emitted")

  /// Détail du dernier échec — message sanitizé (`redactSecretsInString` + `deepSanitize`).
  failureMessage String? @map("failure_message") @db.Text

  /// Acteur du run : `null` = cron automatique ; sinon `User.id` (ADMIN) pour `runs/manual` (audit + RBAC).
  triggeredByUserId String? @map("triggered_by_user_id") @db.Uuid

  mismatches FinanceMismatch[]

  @@index([type, status, startedAt])
  @@index([startedAt])
  @@map("finance_reconciliation_runs")
}

/// Mismatch détecté entre Stripe (source externe) et DB (source opérationnelle).
/// Persisté en DB pour drill-down admin (OQ-11 = DB). PRD-004 §4.15.4.
/// Rétention OQ-12 (CTO Build, pas de rétention indéfinie) : 90 j max — fenêtre
/// `resolvedAt` pour `RESOLVED/IGNORED`, `detectedAt` pour `OPEN/INVESTIGATING`.
model FinanceMismatch {
  id    String                   @id @default(uuid()) @db.Uuid
  runId String                   @map("run_id") @db.Uuid
  run   FinanceReconciliationRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  /// Type fonctionnel du mismatch (label Prometheus + filtre admin).
  type         FinanceMismatchType
  /// Ressource concernée — utilisée pour le drill-down admin + alerte.
  resourceKind FinanceResourceKind @map("resource_kind")
  /// ID interne DB (UUID Payment/Transfer/Refund ou label invariant `FIN-I-XXX`/`FIN-J-XXX`).
  /// String pour supporter les invariants synthétiques (resourceKind=INVARIANT).
  resourceId   String              @map("resource_id") @db.VarChar(64)

  /// Code invariant déterministe (Build itération 2) — versionné, stable dans le temps,
  /// utilisé par dashboards / alertes / runbook / export. Ex. `FIN-I-001`, `FIN-J-001`.
  /// Source de vérité : `apps/api/src/modules/finance/invariants/registry.ts`.
  mismatchCode String @map("mismatch_code") @db.VarChar(16)

  /// Sévérité figée (`P1`/`P2`) — label Prometheus + cooldown alerting.
  severity String @db.VarChar(8)

  /// Delta cents si applicable (`amountDeltaCents`). `null` si statut/type abstrait.
  amountDeltaCents Int? @map("amount_delta_cents")

  /// Snapshot DB sanitisé (`sanitizeForFinanceSnapshot`) — whitelist ADR-018 §4.1.
  dbSnapshot     Json  @map("db_snapshot")
  /// Snapshot Stripe sanitisé (`sanitizeForFinanceSnapshot`) — whitelist ADR-018 §4.1.
  /// `null` quand `resourceKind=INVARIANT` (pas de pendant Stripe direct).
  stripeSnapshot Json? @map("stripe_snapshot")

  /// État admin — drives `mismatches_open_count` gauge + alerting cooldown.
  status FinanceMismatchStatus @default(OPEN)

  detectedAt       DateTime  @default(now()) @map("detected_at")
  /// Build itération 2 — étape intermédiaire `ACKNOWLEDGED`. Trace l'instant
  /// où l'admin reconnaît le mismatch (peut précéder ou non la résolution).
  acknowledgedAt   DateTime? @map("acknowledged_at")
  acknowledgedByUserId String? @map("acknowledged_by_user_id") @db.Uuid
  resolvedAt       DateTime? @map("resolved_at")
  /// ID admin ayant résolu/ignoré — audit (`MissionEvent.actorUserId`). `null` pour OPEN/ACK/INVESTIGATING.
  resolvedByUserId String?   @map("resolved_by_user_id") @db.Uuid
  /// Notes admin (max 1 KiB). Validation Zod côté service.
  resolutionNotes  String?   @map("resolution_notes") @db.VarChar(1024)

  /// Dedup naturelle Build itération 2 — un même run peut détecter plusieurs invariants
  /// cassés sur la même ressource ⇒ unicité sur `(runId, mismatchCode, resourceKind, resourceId)`.
  @@unique([runId, mismatchCode, resourceKind, resourceId])
  @@index([status, severity, detectedAt])
  @@index([resourceKind, resourceId])
  @@index([type, detectedAt])
  @@index([mismatchCode, detectedAt])
  @@map("finance_mismatches")
}

/// Snapshot quotidien J-1 (5 KPIs + invariant balance) — PRD-004 §4.15.4 + US-4.5.4.
/// Rétention : **5 ans** (pratique comptable). Une seule ligne par `reportDate`.
model FinanceDailyReport {
  id String @id @default(uuid()) @db.Uuid

  /// Date civile J-1 Europe/Paris (date sans heure — `DATE` côté Postgres).
  reportDate DateTime @unique @map("report_date") @db.Date

  /// Bornes effectives (UTC) — pour l'audit fenêtre exacte agrégée.
  windowFrom DateTime @map("window_from")
  windowTo   DateTime @map("window_to")

  /// KPIs J-1 (cents). Agrégats SUM sur `Payment.amountCapturedCents`, etc.
  /// Aucun userId/missionId/email ici — uniquement des sommes.
  capturedCents     Int @default(0) @map("captured_cents")
  transferSentCents Int @default(0) @map("transfer_sent_cents")
  refundedCents     Int @default(0) @map("refunded_cents")
  commissionCents   Int @default(0) @map("commission_cents")

  /// `invariantBalanceCents` = capture - transfer - refund - commission. Idéal ≈ 0.
  invariantBalanceCents Int @map("invariant_balance_cents")

  capturedCount     Int @default(0) @map("captured_count")
  transferSentCount Int @default(0) @map("transfer_sent_count")
  refundedCount     Int @default(0) @map("refunded_count")
  openMismatchCount Int @default(0) @map("open_mismatch_count")

  /// Format embed/email — JSON sanitizé prêt à renvoyer côté admin UI / mailer.
  /// Whitelist ADR-018 §4.1 appliquée à la génération.
  snapshot Json

  generatedAt DateTime @default(now()) @map("generated_at")

  @@index([reportDate])
  @@map("finance_daily_reports")
}

/// Trace des alertes finance émises — PRD-004 §4.15.4 (OQ-11). Permet audit cooldown
/// post-mortem (sans dépendre des logs). Rétention : 30 j.
model FinanceAlert {
  id String @id @default(uuid()) @db.Uuid

  /// Identifiant logique de l'alerte (cf. PRD-004 §4.15.7) — string libre côté Prisma,
  /// borné côté Zod / `AlertKind` enum (`finance_mismatch`, `finance_stuck_funds`, …).
  kind String @db.VarChar(64)

  /// Sévérité (`P1`/`P2`) — corrélée à `AlertingService.routing`.
  severity String @db.VarChar(8)

  /// Mismatch lié si applicable (FK soft : `SetNull` pour ne pas perdre la trace
  /// quand un mismatch est purgé à 90 j).
  mismatchId String? @map("mismatch_id") @db.Uuid

  /// Run lié si applicable (idem soft FK).
  runId String? @map("run_id") @db.Uuid

  /// Contexte payload **déjà sanitizé** (`sanitizeForAlert`/`sanitizeForFinanceSnapshot`).
  /// Whitelist : `mismatchId`, `runId`, `resourceKind`, `mismatchType`, `severity`,
  /// `amountDeltaCents`, `stripeIdTruncated` (24 chars max). PRD-004 §4.15.7.
  context Json

  emittedAt DateTime @default(now()) @map("emitted_at")

  @@index([severity, kind, emittedAt])
  @@index([mismatchId])
  @@map("finance_alerts")
}

/// Verrou anti-overlap pour les schedulers finance — ajustement CTO obligatoire
/// (lock DB plutôt que Redis pour traçabilité + indépendance d'infra). PRD-004
/// §4.15.11 ajusté CTO Build. Acquire : `INSERT … ON CONFLICT DO UPDATE WHERE
/// expires_at < NOW()`. Release : `DELETE WHERE key = ? AND owner = ?`.
model FinanceSchedulerLock {
  /// Clé logique du scheduler (cron) — un seul lock actif par scheduler.
  /// Ex. `reconcile`, `stuck`, `invariants`, `payout_anomaly`, `report`, `retention`.
  key String @id @db.VarChar(64)

  /// UUID v4 du propriétaire du lock (worker / pod) — pour debug + `release` sûr.
  owner String @db.VarChar(64)

  acquiredAt DateTime @map("acquired_at")
  /// Expiration absolue (UTC). `expires_at < NOW()` ⇒ lock considéré expiré (auto-cleanable).
  expiresAt  DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("finance_scheduler_locks")
}
