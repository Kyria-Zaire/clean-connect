# ============================================================================
# Clean Connect — Variables d'environnement (template)
# ----------------------------------------------------------------------------
# Copier ce fichier en `.env.local` (jamais committé) et remplir les valeurs.
# Aucune valeur réelle ne doit apparaître ici.
# ============================================================================

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug                                 # trace | debug | info | warn | error

# ---- Database (Postgres + PostGIS) -----------------------------------------
# Format : postgresql://<user>:<password>@<host>:<port>/<db>?schema=public
DATABASE_URL=postgresql://cc:cc@localhost:5434/cleanconnect_dev?schema=public

# ---- Redis (BullMQ + cache) ------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- JWT -------------------------------------------------------------------
# Générer avec : openssl rand -base64 48
JWT_ACCESS_SECRET=__CHANGE_ME_min_48_chars__
JWT_REFRESH_SECRET=__CHANGE_ME_DIFFERENT_min_48_chars__
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- CORS ------------------------------------------------------------------
# Liste séparée par virgules ; jamais "*" en production
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# ---- Stripe ----------------------------------------------------------------
# Préfixe attendu :
#   sk_test_* en dev/recette/preprod
#   sk_live_* en production
STRIPE_SECRET_KEY=sk_test___CHANGE_ME__
STRIPE_WEBHOOK_SECRET=whsec___CHANGE_ME__
# Version API pinned (ADR-011) — bump = ADR dédiée + tests régression.
# Doit correspondre EXACTEMENT à la version configurée sur le webhook endpoint
# du dashboard Stripe (test + live).
STRIPE_API_VERSION=2025-02-24.acacia
# Tolérance HMAC anti-replay (300s = recommandation Stripe).
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_CONNECT_RETURN_URL=http://localhost:5173/connect/return
STRIPE_CONNECT_REFRESH_URL=http://localhost:5173/connect/refresh

# Feature flag — gate complet du module Payments (controller webhook + processors).
# Décision CTO Build PRD-003 : `false` par défaut tant que l'observabilité n'est
# pas branchée en recette/preprod (Verify V11).
FF_PAYMENTS_ENABLED=false

# Version applicative (utilisée par Stripe SDK appInfo). CI peut override.
APP_VERSION=0.1.0-dev

# PRD-003 Ticket 3.2 — taux commission plateforme (snapshot lock-in)
PAYMENT_PLATFORM_FEE_RATE=0.18

# ---- Cloudinary (PRD-003 Ticket 3.3 — ADR-009) ----------------------------
# Format strict : cloudinary://<api_key>:<api_secret>@<cloud_name>
# Requis quand FF_PHOTOS_ENABLED=true (sinon crash boot).
CLOUDINARY_URL=cloudinary://__CHANGE_ME_api_key__:__CHANGE_ME_api_secret__@__CHANGE_ME_cloud_name__
# Préfixe dossier Cloudinary (isolation dev/recette/preprod/prod sur un même cloud).
# Chemin final : <prefix>/missions/<missionId>/<phase>/<captureClientUuid>/<variant>
CLOUDINARY_FOLDER_PREFIX=dev

# Feature flag — gate complet du module Photos (controllers + Cloudinary client).
# `false` par défaut tant que Cloudinary n'est pas branché en recette/preprod.
FF_PHOTOS_ENABLED=false

# Durées (secondes) — défauts ADR-009.
PHOTO_UPLOAD_SESSION_TTL_SECONDS=300
PHOTO_SIGNED_URL_TTL_SECONDS=300

# ---- Firebase Cloud Messaging ---------------------------------------------
FCM_PROJECT_ID=__CHANGE_ME__
FCM_SERVER_KEY=__CHANGE_ME__

# ---- Email transactionnel (à trancher : SendGrid OU Postmark) -------------
MAIL_PROVIDER=sendgrid                          # sendgrid | postmark
MAIL_API_KEY=__CHANGE_ME__
MAIL_FROM=no-reply@cleanconnect.fr

# ---- Sentry ----------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ---- Rate limiting --------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ---- Webhook environment guard --------------------------------------------
# Force la cohérence : un webhook Stripe live ne touche pas une DB de test.
# Valeurs : development | recette | preprod | production
APP_ENV=development

# ---- PRD-004 Ticket 4.5 — Monitoring financier ----------------------------
# Feature flag global — quand `false` (défaut MVP) les @Cron schedulers finance
# court-circuitent leur tick (aucun appel Stripe API). Active en recette
# quand les dashboards Grafana finance sont prêts.
FF_FINANCE_MONITORING_ENABLED=false
# Seuil détection anomalie payout — bornes [1.5, 5.0], défaut 2.0.
FINANCE_PAYOUT_ANOMALY_FACTOR=2.0
# Rate-limit manual run finance — 1/heure/admin (OQ-13).
FINANCE_MANUAL_RUN_RATE_LIMIT_PER_HOUR=1
# Reconcile pagination (PRD-004 §4.15.17 FIN-RECONCILE-PAGING) — page size + borne d'itérations.
FINANCE_RECONCILE_BATCH_SIZE=600
FINANCE_RECONCILE_MAX_PAGES=100
# Rétention DB (jours) — OQ-12.
FINANCE_MISMATCH_RETENTION_DAYS=90
FINANCE_DAILY_REPORT_RETENTION_DAYS=1825
FINANCE_ALERT_RETENTION_DAYS=30

# ---- Mobile (Expo) ---------------------------------------------------------
# URL absolue de l'API consommée par l'app mobile. Préfixe `EXPO_PUBLIC_*`
# requis par Expo SDK 50+ pour exposition côté bundle.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
