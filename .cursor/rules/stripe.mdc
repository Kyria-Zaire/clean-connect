## Conditions de libération (auto ou manuelle) — `canReleaseEscrow`

```typescript
async canReleaseEscrow(missionId: string): Promise<{ ok: boolean; reason?: string }> {
  const mission = await this.repo.findById(missionId)

  if (mission.status === 'DISPUTE_OPEN') return { ok: false, reason: 'dispute_open' }
  if (!['CLIENT_VALIDATION_PENDING', 'AUTO_RELEASE_PENDING'].includes(mission.status)) {
    return { ok: false, reason: 'invalid_mission_status' }
  }

  const photosBefore = await this.photos.count(missionId, 'BEFORE', { synced: true })
  if (photosBefore < 3) return { ok: false, reason: 'photos_before_insufficient' }

  const photosAfter = await this.photos.count(missionId, 'AFTER', { synced: true })
  if (photosAfter < 5) return { ok: false, reason: 'photos_after_insufficient' }

  const payment = await this.repo.findPaymentByMission(missionId)
  if (payment.status !== 'AUTHORIZED') return { ok: false, reason: 'payment_not_authorized' }

  const prestataire = await this.users.findById(mission.prestataireId)
  if (prestataire.providerPayoutStatus !== 'READY') return { ok: false, reason: 'payouts_disabled' }

  return { ok: true }
}
```

**Règle dure** : pas de libération si une seule condition est fausse. Audit `AUTO_RELEASE_BLOCKED { reason }` + alerte admin.

