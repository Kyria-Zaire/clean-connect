## Vérification webhook — séquence stricte + réponse 202 async

```typescript
@Post('webhooks/stripe')
@HttpCode(HttpStatus.ACCEPTED) // 202 — traitement async, Stripe ne timeout pas
async handle(
  @Req() req: RawBodyRequest<Request>,
  @Headers('stripe-signature') signature: string,
) {
  // 1. Signature AVANT toute désérialisation (constructEvent + raw body)
  let event: Stripe.Event
  try {
    event = this.stripe.webhooks.constructEvent(req.rawBody, signature, env.STRIPE_WEBHOOK_SECRET)
  } catch (err) {
    throw new BadRequestException({ error: 'WEBHOOK_INVALID_SIGNATURE' })
  }

  // 2. Cohérence env (sk_test_* ne reçoit jamais livemode=true, et inverse)
  this.assertEnvConsistency(event)

  // 3. Warning api_version mismatch (ADR-011) — pas un reject, juste audit
  if (event.api_version !== env.STRIPE_API_VERSION) {
    this.logger.warn(
      { eventId: event.id, eventApiVersion: event.api_version, expected: env.STRIPE_API_VERSION },
      'webhook.api_version.mismatch',
    )
  }

  // 4. Anti-replay : StripeWebhookEvent.stripeEventId PK + payload_hash sha256
  const payloadHash = createHash('sha256').update(req.rawBody).digest('hex')
  try {
    await this.prisma.stripeWebhookEvent.create({
      data: {
        stripeEventId: event.id, // PK = idempotent par construction
        type: event.type,
        payload: event as any,
        payloadHash,
        processingStatus: 'PENDING',
        livemode: event.livemode,
      },
    })
  } catch (err: any) {
    if (err.code === 'P2002') {
      // Doublon Stripe — renvoyer 202 sans réenfiler (anti double traitement)
      return { accepted: true, idempotent: true }
    }
    throw err
  }

  // 5. Enqueue traitement asynchrone (BullMQ jobId déterministe)
  await this.webhookQueue.add(
    'process',
    { stripeEventId: event.id },
    {
      jobId: `stripe-webhook-${event.id}`, // idempotence BullMQ
      attempts: 5,
      backoff: { type: 'exponential', delay: 30_000 },
      removeOnFail: false,
    },
  )

  return { accepted: true } // 202 — confirme à Stripe, traitement async
}

private assertEnvConsistency(event: Stripe.Event) {
  const isLiveEvent = event.livemode
  const isProdEnv = env.NODE_ENV === 'production'
  if (isLiveEvent !== isProdEnv) {
    throw new BadRequestException({
      error: 'WEBHOOK_LIVEMODE_MISMATCH',
      reason: `Webhook livemode=${isLiveEvent} mismatches env=${env.NODE_ENV}`,
    })
  }
}
```

**Règles dures** :
- Réponse `202 Accepted` rapide (< 200 ms) ; tout traitement métier dans le worker BullMQ.
- Table dédiée **`StripeWebhookEvent`** (D19) — pas de `stripeEvent` générique : `stripeEventId` PK + `payloadHash` SHA-256 (anti-tampering + replay détection).
- Replay même `stripeEventId` → 202 idempotent, code interne `WEBHOOK_ALREADY_PROCESSED` côté worker BullMQ si on tente de re-traiter.

