## Sync background

```typescript
// app/_layout.tsx ou similaire
import * as BackgroundFetch from 'expo-background-fetch'
import * as TaskManager from 'expo-task-manager'

const SYNC_TASK = 'photo-sync-task'

TaskManager.defineTask(SYNC_TASK, async () => {
  try {
    const success = await processSyncQueue()
    return success
      ? BackgroundFetch.BackgroundFetchResult.NewData
      : BackgroundFetch.BackgroundFetchResult.NoData
  } catch {
    return BackgroundFetch.BackgroundFetchResult.Failed
  }
})

await BackgroundFetch.registerTaskAsync(SYNC_TASK, {
  minimumInterval: 60,           // 1 min minimum entre exécutions
  stopOnTerminate: false,
  startOnBoot: true,
})
```

### Retry exponentiel

```typescript
const BACKOFF_MS = [5_000, 30_000, 120_000, 600_000, 3_600_000]  // 5s, 30s, 2m, 10m, 1h

async function processSyncQueue() {
  const queue = readQueue()
  for (const item of queue) {
    if (Date.now() - item.lastAttemptAt < BACKOFF_MS[item.attempts]) continue
    try {
      await uploadPhoto(item)
      removeFromQueue(item.uuid)
    } catch (err) {
      item.attempts += 1
      item.lastAttemptAt = Date.now()
      if (item.attempts >= 5) markAsManualRetry(item)
      updateQueueItem(item)
    }
  }
}
```

