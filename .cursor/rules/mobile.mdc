## State serveur — TanStack Query uniquement

```typescript
// ❌ useEffect + fetch
useEffect(() => {
  fetch('/api/missions').then(...)
}, [])

// ✅ TanStack Query
const { data, isLoading, error } = useQuery({
  queryKey: ['missions'],
  queryFn: () => api.missions.list(),
  staleTime: 30_000,
})

// ✅ Mutation avec invalidation
const acceptMission = useMutation({
  mutationFn: (id: string) => api.missions.accept(id),
  onSuccess: () => queryClient.invalidateQueries({ queryKey: ['missions'] }),
})
```

