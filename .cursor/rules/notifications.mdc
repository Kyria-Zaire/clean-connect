## Envoi push — Expo Server SDK

```typescript
import { Expo, ExpoPushMessage } from 'expo-server-sdk'

@Injectable()
export class PushService {
  private readonly expo = new Expo({ accessToken: env.EXPO_ACCESS_TOKEN }) // optionnel

  async sendToUser(userId: string, payload: PushPayload) {
    const tokens = await this.prisma.pushToken.findMany({
      where: { userId, active: true },
      select: { token: true },
    })

    const messages: ExpoPushMessage[] = tokens
      .filter(t => Expo.isExpoPushToken(t.token)) // filtre tokens malformés
      .map(t => ({
        to: t.token,
        sound: 'default',
        title: payload.title,
        body: payload.body,
        data: payload.data ?? {},
        priority: 'high',
        channelId: 'default',
      }))

    if (messages.length === 0) return

    const chunks = this.expo.chunkPushNotifications(messages)
    for (const chunk of chunks) {
      try {
        const tickets = await this.expo.sendPushNotificationsAsync(chunk)
        await this.handleTickets(tickets, chunk) // désactive tokens DeviceNotRegistered
      } catch (err) {
        logger.error({ err, userId }, 'push.send.failed')
      }
    }
  }
}
```

**Règles dures** :
- `Expo.isExpoPushToken(token)` filtre AVANT envoi.
- Ticket `DeviceNotRegistered` → `PushToken.active = false` (logging warn, pas une erreur applicative).
- Pino structuré : `push.send.success`, `push.send.failed`, `push.ticket.error`.

