## RGPD — Export utilisateur (droit à la portabilité)

```typescript
@Get('me/export')
@UseGuards(JwtAuthGuard)
async exportMyData(@CurrentUser() user: AuthUser) {
  const data = await this.users.exportAllDataFor(user.id)
  return {
    user: data.user,
    missions: data.missions,
    photos: data.photos.map(p => ({
      ...p,
      signedUrl: this.photos.getSignedReadUrl(p.id, user),
    })),
    payments: data.payments,
    exportedAt: new Date().toISOString(),
  }
}
```

