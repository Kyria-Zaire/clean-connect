## RGPD — Droit à l'effacement utilisateur

Quand `DELETE /api/users/me` :

```typescript
async deleteUserAccount(userId: string) {
  await this.prisma.user.update({
    where: { id: userId },
    data: {
      deletedAt: new Date(),
      email: `deleted-${userId}@anon.local`,
      firstName: 'Anon',
      lastName: 'User',
      phone: null,
      avatarUrl: null,
    },
  })

  // Schedule purge à T+30j
  await this.queue.add(
    'user.purge',
    { userId },
    { delay: 30 * 24 * 3600 * 1000 },
  )
}

@Process('user.purge')
async purgeUser(job: Job<{ userId: string }>) {
  const userId = job.data.userId

  // Supprimer les photos uploadées par cet utilisateur (uniquement les photos hors missions clôturées)
  const photos = await this.prisma.photo.findMany({
    where: {
      uploadedBy: userId,
      mission: { completedAt: null },   // missions en cours : on garde pour litige
    },
  })
  for (const p of photos) {
    await cloudinary.uploader.destroy(p.cloudinaryPublicId, { type: 'private' })
  }

  await this.prisma.photo.deleteMany({
    where: { uploadedBy: userId, mission: { completedAt: null } },
  })

  // Hard delete user (sauf transactions Stripe : conservées 10 ans)
  await this.prisma.user.delete({ where: { id: userId } })
}
```

